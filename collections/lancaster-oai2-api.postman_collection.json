                    },
                    {
                      "key": "set",
                      "value": "<string>"
                    },
                    {
                      "key": "from",
                      "value": "<dateTime>"
                    },
                    {
                      "key": "until",
                      "value": "<dateTime>"
                    },
                    {
                      "key": "resumptionToken",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
