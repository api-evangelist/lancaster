  "info": {
    "_postman_id": "c503c013-9e5e-4d16-a609-499bfcc10fbc",
    "name": "Lancaster EPrints OAI-PMH 2.0 Interface Oai2 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "OpenAPI 3.0 description of the live OAI-PMH 2.0 metadata harvesting interface exposed by the Lancaster EPrints institutional repository (EPrints 3.4.5). The interface is a single HTTP endpoint that dispatches on the required \"verb\" query parameter and returns OAI-PMH XML envelopes. This description was derived by probing the live endpoint; only verbs, parameters, metadata formats, and response objects observed in production are represented.\n\nContact Support:\n Name: Lancaster University Library (DIT)\n Email: library.dit@lancaster.ac.uk",
      "type": "text/plain"
    }
  }
