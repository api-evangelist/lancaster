      "item": [
        {
          "id": "b313e8ca-38dc-4f2a-abb7-3cf52f7769f1",
          "name": "OAI-PMH request dispatch",
          "request": {
            "name": "OAI-PMH request dispatch",
            "description": {
              "content": "Single OAI-PMH endpoint. The \"verb\" parameter selects the operation. Responses are OAI-PMH XML envelopes (Content-Type text/xml). Parameter applicability depends on the verb per the OAI-PMH 2.0 specification.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oai2"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "verb",
                  "value": "<string>",
                  "description": "(Required) The OAI-PMH verb to execute."
                },
                {
                  "disabled": false,
                  "key": "metadataPrefix",
                  "value": "<string>",
                  "description": "Metadata format to disseminate. Required for ListRecords, ListIdentifiers, and GetRecord (unless a resumptionToken is used). Observed supported formats on this repository."
                },
                {
                  "disabled": false,
                  "key": "identifier",
                  "value": "<string>",
                  "description": "OAI item identifier, e.g. oai:eprints.lancs.ac.uk:10175. Required for GetRecord."
                },
                {
                  "disabled": false,
                  "key": "set",
                  "value": "<string>",
                  "description": "Set spec to selectively harvest a subset of records."
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<dateTime>",
                  "description": "Lower bound (inclusive) for selective harvesting by datestamp. Granularity YYYY-MM-DDThh:mm:ssZ."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "Upper bound (inclusive) for selective harvesting by datestamp. Granularity YYYY-MM-DDThh:mm:ssZ."
                },
                {
                  "disabled": false,
                  "key": "resumptionToken",
                  "value": "<string>",
                  "description": "Flow-control token returned in an incomplete list response; used to request the next page. Exclusive of other selective arguments."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "e2244ae0-c6a2-4828-ae7d-e20169854e52",
              "name": "OAI-PMH XML envelope (success or OAI error element).",
              "originalRequest": {
                "url": {
                  "path": [
                    "oai2"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "verb",
                      "value": "<string>"
                    },
                    {
